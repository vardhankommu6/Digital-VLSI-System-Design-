module question3 (
    input  wire clk,
    input  wire seat_sensor,
    input  wire seat_belt_sensor,
    output reg  buzzer
);

always @(posedge clk) begin
    if (seat_sensor && !seat_belt_sensor)
        buzzer <= 1'b1;
    else
        buzzer <= 1'b0;
end

endmodule
