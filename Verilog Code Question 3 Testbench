module question3_tb;
reg clk,seat_sensor,seat_belt_sensor;
wire buzzer;
question3 uut (.clk(clk),.seat_sensor(seat_sensor),.seat_belt_sensor(seat_belt_sensor),.buzzer(buzzer));
always #5 clk = ~clk;
initial begin
    clk = 0;
    seat_sensor = 0;
    seat_belt_sensor = 0;
    #10;
    seat_sensor = 1;
    seat_belt_sensor = 0;
    #10;
    seat_sensor = 1;
    seat_belt_sensor = 1;
    #10;
    seat_sensor = 0;
    seat_belt_sensor = 0;
    #10;

    $finish;
end
endmodule
