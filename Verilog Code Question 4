module question4 (
    input clk,occupancy,is_dark,manual_on,
    output reg light_on,
    output reg light_latch
);
always @(*) begin
    light_on = (occupancy && is_dark) || manual_on || light_latch;
end
always @(posedge clk) begin
    light_latch <= light_on;
end
endmodule
