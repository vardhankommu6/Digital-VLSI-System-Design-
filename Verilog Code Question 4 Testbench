module question4_tb;
reg clk,occupancy,is_dark,manual_on;
wire light_on,light_latch;
question4 uut (
    .clk(clk),
    .occupancy(occupancy),
    .is_dark(is_dark),
    .manual_on(manual_on),
    .light_on(light_on),
    .light_latch(light_latch)
);
always #5 clk = ~clk;
initial begin
    clk = 0;
    occupancy = 0;
    is_dark = 0;
    manual_on = 0;
    #10;
    occupancy = 1;
    is_dark = 1;
    #10;
    manual_on = 1;
    #10;
    manual_on = 0;
    #10;
    occupancy = 0;
    is_dark = 0;
    #20;
    $finish;
end
endmodule
