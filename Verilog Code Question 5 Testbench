module question5_tb;
reg clk,rst_n,sensor,door_full_open,door_full_closed;
wire opening,open,closing;
question5 uut (
    .clk(clk),
    .rst_n(rst_n),
    .sensor(sensor),
    .door_full_open(door_full_open),
    .door_full_closed(door_full_closed),
    .opening(opening),
    .open(open),
    .closing(closing)
);
always #5 clk = ~clk;
initial begin
    clk = 0;
    rst_n = 0;
    sensor = 0;
    door_full_open = 0;
    door_full_closed = 0;
    #10;
    rst_n = 1;
    #10;
    sensor = 1;
    #10;
    door_full_open = 1;
    #10;
    door_full_open = 0;
    sensor = 0;
    #20;
    door_full_closed = 1;
    #10;
    $finish;
end
endmodule
